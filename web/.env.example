# === Anthropic (lettres + repli du benchmark quand LINKUP_API_KEY est vide) ===
# La catégorisation des marchands n'utilise plus Claude : voir HAI_API_KEY plus bas.
ANTHROPIC_API_KEY=

# Modèle Claude des lettres et du benchmark (défaut : claude-sonnet-5).
ARGENTIER_MODEL=claude-sonnet-5

# === Linkup (benchmark prix — le MÊME fournisseur que le MCP Linkup du skill) ===
# Avec cette clé, /api/benchmark cherche via l'API Linkup (label « via Linkup »).
# Sans elle, il retombe sur la recherche web hébergée de Claude (label « via Claude »).
# Clé sur app.linkup.so.
LINKUP_API_KEY=

# === Qonto — connexion OAuth du visiteur (chemin normal) ===
# Serveur d'autorisation utilisé : « mcp-proxy » (défaut, le proxy MCP de Qonto)
# ou « direct-readonly » (client OAuth dédié en lecture seule, le jour où Qonto
# en délivre un à Kerdaxis). Bascule par configuration, sans changement de code.
QONTO_OAUTH_PROVIDER=mcp-proxy

# client_id OAuth. Inutile avec « mcp-proxy » (client public partagé
# « qonto-mcp-public », renvoyé par l'enregistrement dynamique) ; OBLIGATOIRE
# avec « direct-readonly ».
QONTO_OAUTH_CLIENT_ID=

# URL publique de Kerdaxis, sans slash final. Sert à construire la redirect_uri
# (<base>/api/auth/qonto/callback) et les retours vers /demo. Défaut :
# http://localhost:3000. Une base en http:// désactive le drapeau Secure des
# cookies (développement local uniquement).
ARGENTIER_BASE_URL=http://localhost:3000

# redirect_uri explicite, si elle doit différer de <ARGENTIER_BASE_URL>/api/auth/qonto/callback.
# QONTO_OAUTH_REDIRECT_URI=

# Clé de chiffrement des jetons OAuth au repos : 32 octets en base64 (AES-GCM).
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Absente, le stockage des jetons échoue — aucun repli en clair n'est autorisé.
ARGENTIER_TOKEN_KEY=

# Secret de signature du cookie de session (HMAC-SHA256), 32 caractères minimum.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Le changer déconnecte instantanément toutes les sessions en cours.
ARGENTIER_SESSION_SECRET=

# === Mode dégradé (jetons en mémoire, aucun journal d'audit) ===
# Hors production, l'absence des bindings Cloudflare est tolérée : les jetons
# tiennent en mémoire du process et rien n'est journalisé. C'est un confort de
# poste de travail, jamais un mode de service.
# En production (NODE_ENV=production), l'absence de ARGENTIER_TOKENS (KV) ou de
# ARGENTIER_DB (D1) fait LEVER : un jeton bancaire qu'on ne sait ni chiffrer ni
# révoquer, et une lecture bancaire sans trace, sont des incidents — pas des
# replis. Poser cette variable à 1 rouvre le mode dégradé même en production :
# réservé à un `next build` local ou à l'inspection d'un bundle, JAMAIS pour
# servir du trafic réel.
# ARGENTIER_ALLOW_DEGRADED_BINDINGS=1

# === Qonto — clé API statique : SUPPRIMÉE, ne pas la remettre ===
# QONTO_LOGIN, QONTO_SECRET_KEY et QONTO_IBAN n'existent plus. Elles décrivaient
# UNE clé, celle du fondateur, partagée par tous les visiteurs et dotée des
# droits d'ÉCRITURE complets. Deux défauts, tous deux corrigés par la
# suppression du client `lib/qonto.ts` :
#   - un visiteur connecté dont le jeton avait disparu (session encore valide,
#     rafraîchissement refusé) basculait sur cette clé et se voyait servir le
#     compte bancaire RÉEL du fondateur, badgé « live » ;
#   - ce client appelait `fetch` sans passer par l'allowlist read-only, seule
#     frontière qui empêche Kerdaxis de bouger de l'argent.
# Si ces variables traînent encore dans un environnement de déploiement
# (Cloudflare, Vercel), RETIRE-LES : elles ne sont plus lues, et une clé API
# write-capable qui subsiste dans un secret store reste une clé exfiltrable.
# Le seul mode d'authentification admis est le jeton OAuth du visiteur, et
# `lib/mcp/__tests__/invariant-fetch-qonto.test.ts` passe au rouge si l'une de
# ces variables réapparaît dans le code.

# Fenêtre d'analyse en jours (défaut 60 = deux fenêtres de 30 j glissantes).
ARGENTIER_WINDOW_DAYS=60

# === API moteur publique (/api/v1/engine) ===
# Jetons Bearer acceptés par POST /api/v1/engine/analyze et /simulate, séparés
# par des virgules. VIDE ou absent = l'API est FERMÉE (répond 503). Chaque jeton
# est plafonné à 60 requêtes/minute. Générer un jeton :
#   node -e "console.log('eng_'+require('crypto').randomBytes(24).toString('hex'))"
# GET /api/v1/engine/health reste ouverte (aucune donnée, juste la version).
ENGINE_API_TOKENS=

# === ElevenLabs (voix : explique la page dans la langue + Q&A vocal) ===
# TTS : la clé reste côté serveur (route /api/voice). Clé sur elevenlabs.io.
ELEVENLABS_API_KEY=
# Voix TTS (optionnel ; vide = voix multilingue par défaut).
ELEVENLABS_VOICE_ID=
# Agent conversationnel PUBLIC (Q&A vocal). Vide = widget Q&A désactivé, TTS actif.
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# ===================== Kerdaxis =====================
# H Company. One key for both APIs:
#   - Agents API: the computer-use agent that cancels on the supplier portal.
#   - Models API: the Holo model that labels merchants in /api/analyze.
#     Without the key (or if the call fails), labels come from the keyword rules.
HAI_API_KEY=
# Holo model for merchant labels (default holo4-27b). Base URL is overridable for tests.
HAI_CATEGORIZE_MODEL=holo4-27b
# HAI_MODELS_BASE_URL=https://api.hcompany.ai/v1

# Gladia live speech-to-text (voice commands). Server-side only.
GLADIA_API_KEY=

# Demo supplier portal (portal/, Cloudflare Worker "Nuvio CRM", fictional).
PORTAL_BASE_URL=https://portal.kerdaxis.com
PORTAL_API_KEY=
PORTAL_LOGIN_TOKEN=
# "en" serves the portal in English to the agent (default: French).
PORTAL_LANG=en

# Access to the exposed app (app.kerdaxis.com via Cloudflare Tunnel).
# Jury / test password, and the HMAC secret signing every session cookie (32+ chars).
KERDAXIS_TEST_PASSWORD=
KERDAXIS_SESSION_SECRET=
# Optional bearer token for operator scripts on the execution routes.
KERDAXIS_OPERATOR_TOKEN=

# Stripe, TEST MODE ONLY (sk_test_...). A live key is refused unless STRIPE_ALLOW_LIVE=1.
STRIPE_SECRET_KEY=
# STRIPE_ALLOW_LIVE=1
