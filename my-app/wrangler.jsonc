{
	"name": "argentier-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-12",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true,
	},
	// The MCP server (Durable Object ArgentierMCP) was removed: v2 deletes the
	// deployed class so the next `wrangler deploy` accepts the change.
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["ArgentierMCP"] },
		{ "tag": "v2", "deleted_classes": ["ArgentierMCP"] },
	],
	"kv_namespaces": [{ "binding": "WAITLIST", "id": "2654f9c6be0d425a921a5d732b8ce518" }],
}
